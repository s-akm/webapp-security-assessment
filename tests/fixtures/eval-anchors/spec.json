{
  "name": "example",
  "require": [
    "docs/answers.md"
  ],
  "items": [
    {
      "id": "sqli-search",
      "basis": "例",
      "category": "Injection",
      "anchors": [
        [
          "app/server.js",
          "SELECT id FROM items WHERE name"
        ]
      ]
    },
    {
      "id": "list-handler",
      "basis": "例",
      "category": "Misc",
      "anchors": [
        [
          "app/routes.ts",
          "@Get('list')"
        ]
      ],
      "until": "^\\s*@(Get|Post|Put|Delete|Patch|All)\\("
    },
    {
      "id": "run-handler",
      "basis": "例",
      "category": "Injection",
      "anchors": [
        [
          "app/routes.ts",
          "@Get('run')"
        ],
        [
          "app/service.ts",
          "async launch(",
          "^\\s*(async\\s+)?[A-Za-z]\\w*\\s*\\("
        ]
      ],
      "until": "^\\s*@(Get|Post|Put|Delete|Patch|All)\\("
    },
    {
      "id": "mobile-search",
      "basis": "例",
      "category": "Injection",
      "anchors": [
        [
          "mobile/SqlInjectionScreen.kt",
          "db.rawQuery("
        ]
      ]
    },
    {
      "id": "mobile-store",
      "basis": "例",
      "category": "Sensitive Data Exposure",
      "anchors": [
        [
          "mobile/vulnerable_cache/Store.kt",
          "prefs.putString("
        ]
      ]
    },
    {
      "id": "list-lines",
      "basis": "例",
      "category": "Misc",
      "scope": "out",
      "note": "続く行と n 回目の一致の例",
      "anchors": [
        [
          "app/service.ts",
          "async ",
          {
            "nth": 2,
            "lines": 3
          }
        ],
        [
          "app/service.ts",
          "return [",
          {
            "lines": 2
          }
        ]
      ]
    },
    {
      "id": "doc-only",
      "basis": "例",
      "category": "Misc",
      "scope": "out",
      "note": "場所を持たない範囲外の答え",
      "anchors": []
    }
  ],
  "replace_base64": [
    [
      "lab-demo",
      "svc"
    ]
  ],
  "secrets_regex": "svc-[0-9a-f]{32}",
  "secrets_min": 2,
  "paragraph_hint_regex": "VULN:",
  "replace_regex_everywhere": [
    [
      "training-build-\\d+",
      "build"
    ]
  ],
  "rename": [
    [
      "mobile/vulnerable_cache",
      "mobile/local_cache"
    ],
    [
      "mobile/SqlInjectionScreen.kt",
      "mobile/SearchScreen.kt"
    ],
    [
      "mobile/src/vulnerable_lab/notes",
      "mobile/src/com/example/notes"
    ]
  ],
  "remove": [
    "docs",
    "app/**/*.desc.ts"
  ],
  "hint_regex": "injection|vulnerab|weak",
  "residual_regex": "injection|vulnerab",
  "replace": [
    [
      "app/server.js",
      "// 検索の処理",
      "// 検索"
    ],
    [
      "app/server.js",
      "SQL injection: the query",
      "検索の式"
    ]
  ],
  "secrets": [
    "dummy-embedded-value"
  ],
  "replace_regex": [
    [
      "app/service.ts",
      "'As an assistant, [^']*'",
      "'Here is the answer.'"
    ]
  ]
}
